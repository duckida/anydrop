# ── Anycubic account ───────────────────────────────────────────────────────────
# Required. The cloud token for the account that owns the printer.
# Web mode: localStorage["XX-Token"] on https://app.makeronline.com
# Slicer mode: the access token from Anycubic Slicer Next.
ANYCUBIC_TOKEN=

# "web" (default) or "slicer". Slicer tokens are exchanged for a session token
# server-side before each batch of requests.
ANYCUBIC_AUTH_MODE=web

# "global" (default) or "cn" (mainland China cloud).
ANYCUBIC_REGION=global

# ── Access control ─────────────────────────────────────────────────────────────
# Required. The dashboard will not load until this password is set.
ANYDROP_PASSWORD=

# Optional. Signs the session cookie. Defaults to a hash of ANYDROP_PASSWORD.
ANYDROP_SESSION_SECRET=

# ── Uploads ────────────────────────────────────────────────────────────────────
# auto   – browser uploads straight to Anycubic, falls back to Vercel Blob
# direct – browser uploads straight to Anycubic only
# blob   – always stage through Vercel Blob (server relays to Anycubic)
ANYDROP_UPLOAD_MODE=auto

# Vercel Blob read/write token. Only needed for the fallback path. Add a Blob
# store in your Vercel project and this is injected automatically.
BLOB_READ_WRITE_TOKEN=

# Access mode of that Blob store: "public" (default) or "private". Must match
# the store's configuration in Vercel.
ANYDROP_BLOB_ACCESS=public

# Largest file the UI will accept (MB). Default 2.
ANYDROP_MAX_UPLOAD_MB=2

# Largest file the Blob relay path will buffer server-side (MB).
ANYDROP_MAX_RELAY_MB=256

# ── Preview ────────────────────────────────────────────────────────────────────
# Set to 1 to render the dashboard with mock printers and no cloud calls.
ANYDROP_DEMO=0
